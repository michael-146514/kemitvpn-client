# Public browser configuration only. Never put Supabase service-role, PureWL,
# database, encryption, or internal API secrets here.
#
# Pick the environment by pointing at its client backend:
#   development (account.nexfyr.com):   VITE_KEMIT_API_URL=https://vpn.nexfyr.com
#   production  (account.kemitvpn.com): VITE_KEMIT_API_URL=https://<production-api-domain>
#   local       (localhost:5174):       VITE_KEMIT_API_URL=http://localhost:4000
# That client backend's ACCOUNT_WEBSITE_URL must be this website's origin for
# "Sign in with KemitVPN" (/oauth/authorize) to send apps here.
VITE_KEMIT_API_URL=https://vpn.nexfyr.com

# Optional. Defaults to <this website's origin>/auth/callback, which is right
# for every environment. This exact URL must be present in server_v2
# OAUTH_REDIRECT_URLS and in Supabase Authentication -> URL Configuration ->
# Redirect URLs (for Apple / Google sign-in on the website).
VITE_OAUTH_REDIRECT_URL=
